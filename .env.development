# Configuración del servidor
PORT=3001
NODE_ENV=development

# Clave secreta para JWT de la aplicación
JWT_SECRET=super_secret_jwt_key_eci_change_in_production_xyz123

# Microsoft Entra ID (Azure AD)
AZURE_AD_TENANT_ID=50640584-2a40-4216-a84b-9b3ee0f3f6cf
# Solo client IDs (públicos) de las apps de Azure del front; NUNCA el client secret. Separados por coma.
# Test: 6e41c1c3-0c43-46b5-8e8b-f6c9b02729d6 | Producción: 86478c0e-05d8-480c-9798-767a09554661
AZURE_AD_CLIENT_IDS=6e41c1c3-0c43-46b5-8e8b-f6c9b02729d6,86478c0e-05d8-480c-9798-767a09554661

# Orígenes del front permitidos, separados por coma
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Conexiones a Bases de Datos (Prisma)
# DB 1: Base de datos principal
DATABASE_URL="sqlserver://localhost:1433;database=eciciencia_db;user=sa;password=YourPassword123;encrypt=true;trustServerCertificate=true"

# DB 2: Base de datos AppMovil (Opcional / Secundaria)
DATABASE_URL_APPMOVIL="sqlserver://localhost:1433;database=appmovil_db;user=sa;password=YourPassword123;encrypt=true;trustServerCertificate=true"

# DB 3: Base de datos Novasoft (Opcional / Terciaria)
DATABASE_URL_NOVASOFT="sqlserver://localhost:1433;database=novasoft_db;user=sa;password=YourPassword123;encrypt=true;trustServerCertificate=true"
