# Configuración del servidor
PORT
NODE_ENV=development

# Clave secreta para JWT de la aplicación
JWT_SECRET=super_secret_jwt_key_eci_change_in_production_xyz123

# Microsoft Entra ID (Azure AD)
AZURE_AD_TENANT_ID
# Solo client IDs (públicos) de las apps de Azure del front; NUNCA el client secret. Separados por coma.
AZURE_AD_CLIENT_IDS

# Orígenes del front permitidos, separados por coma
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Conexiones a Bases de Datos (Prisma)
DATABASE_URL
DATABASE_URL_APPMOVIL
DATABASE_URL_NOVASOFT
