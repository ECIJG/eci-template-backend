datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL_DB2")
}

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma-clients/db-2"
}

// Define aquí los modelos para la Base de Datos 2
// Modelo genérico inicial para permitir la inicialización del cliente Prisma:
model Db2Item {
  id        Int      @id @default(autoincrement())
  nombre    String
  createdAt DateTime @default(now())

  @@map("items_db2")
}
