datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL_DB3")
}

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma-clients/db-3"
}

// Define aquí los modelos para la Base de Datos 3
// Modelo genérico inicial para permitir la inicialización del cliente Prisma:
model Db3Item {
  id        Int      @id @default(autoincrement())
  nombre    String
  createdAt DateTime @default(now())

  @@map("items_db3")
}
